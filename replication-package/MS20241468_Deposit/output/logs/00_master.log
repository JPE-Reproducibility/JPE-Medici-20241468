> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")  
  5.                                                                          
. est store baseline_`outcome'
  6.         
. preserve
  7.         
. foreach country in aus_hung belgium czech denmark ///
>                                    france germany gr_pt_es ///
