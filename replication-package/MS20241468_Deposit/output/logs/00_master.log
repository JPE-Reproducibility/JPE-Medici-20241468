. *   $intmdata/xwalk_occ1950_occnames.dta
. *   $intmdata/xwalk_1930_countynhg_SEA.dta
. *   $intmdata/xwalk_statefip_stateicp.dta
. *   $intmdata/xwalk_1900_countynhg_countyicp.dta
. *   $data/flows_imm_1820-2021.dta
