  4.     gen pr1890_sh_wa_`i' = pr1890_`i'_wa_10yr_m / pr1890_euro_wa_10yr_m
  5.     replace pr1890_sh_wa_`i' = 0 if pr1890_euro_wa_10yr_m == 0
  6. }
