. 
. *------------------------------------------------------------------------------*
. * Baseline by type of union (skill)
. * Paper: Heterogeneous Effects by Workers' Skills (Table 5); outputs byskill_sk, byskill_unsk
. *------------------------------------------------------------------------------*
. 
. foreach unionclass in byskill {
  2.         
. if "`unionclass'" == "byskill" {
  3. local unions = "sk unsk"                
  4. }
  5. foreach union of local unions {
  6. 
. local filename = "`unionclass'_`union'"
  7. local n = 4     
  8. 
. foreach fmt in txt xml {        
  9. cap erase "$tables/`filename'.`fmt'"            
 10. }
 11. 
. foreach outcome in pres ihsloc dens avgmemb  {
 12.                 
. local var = "afl_comb_`union'_`outcome'"
 13. 
. ivreghdfe `var'                                          (sh_euro_wa_10yr_m = pr1890_sh_euro_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1 & insample_balanced == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")  
 14. 
. local obs = string(e(N),"%15.0f")                                                                        
 15. local fstat = string(`e(widstat)',"%6.2fc")
 16. qui sum `var' if e(sample) == 1
 17. if "`outcome'" == "ihsloc" {
 18. qui sum afl_comb_`union'_locals if e(sample) == 1
 19. } 
 20. local depvarmean = string(r(mean),"%6.3fc")
 21. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 22. local sheuromean = string(r(mean),"%6.3fc")
 23. local sheurostdev = string(r(sd),"%6.3fc")
 24. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se) bracket(beta) paren(se) ///
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", "${fetext}, ${controls
> text`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*) 
 25. 
. }
 26. 
. foreach fmt in txt {    
 27. cap erase "$tables/`filename'.`fmt'"                    
 28. }
 29.         
. }
 30. 
. }
