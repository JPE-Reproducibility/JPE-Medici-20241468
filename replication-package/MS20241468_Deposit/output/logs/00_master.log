> _t23) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first 
 31. est store segr_`union'_`outcome'
 32. 
. local obs = string(e(N),"%15.0f")                                                                        
 33. local fstat = string(`e(widstat)',"%6.2fc")
 34. mat first = e(first)
 35. local partfstat1 = string(first[8,1],"%6.2fc")
 36. local partfstat2 = string(first[8,2],"%6.2fc")
 37. qui sum `var' if e(sample) == 1
 38. if "`outcome'" == "ihsloc" {
 39. qui sum afl_comb_`union'_locals if e(sample) == 1
 40. } 
 41. local depvarmean = string(r(mean),"%6.3fc")
 42. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 43. local sheuromean = string(r(mean),"%6.3fc")
 44. local sheurostdev = string(r(sd),"%6.3fc")
 45. nlcom lc: _b[sh_euro_wa_10yr_m] + _b[sh_euro_segr_en_t23], post
 46. local coef_lc = string(_b[lc],"%6.3fc")
 47. local se_lc = string(_se[lc],"%6.3fc")
 48. est restore segr_`union'_`outcome'                                                                       
 49. 
. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se) bracket(beta) paren(se) ///
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean, "`sheuromean'", ///
