. *------------------------------------------------------------------------------*
. * Heterogeneity by residential segregation
. * Paper: Heterogeneous Effects by Attitudes Towards Immigration, Panel B
. *        (Table 8; terciles in Table A.6);
. *        outputs het_residsegr_all, het_residsegr_all_alt
. *------------------------------------------------------------------------------*
. foreach union in all {
  2. 
. local n = 4     
  3. 
. local filename = "het_residsegr_`union'"
  4. foreach fmt in txt xml {        
  5. cap erase "$tables/`filename'.`fmt'"            
  6. cap erase "$tables/`filename'_alt.`fmt'"                        
  7. }
  8. 
. preserve
  9. 
. foreach i in resid_segr_euro_enum_1880 {
 10. xtile `i'_t = `i' if insample_balanced == 1 & inrange(year,1900,1920) == 1, n(3)
 11. tab `i'_t if insample_balanced == 1 & inrange(year,1900,1920) == 1, gen(`i'_t)
 12. gen `i'_t23 = (`i'_t2 == 1 | `i'_t3 == 1) if insample_balanced == 1 & inrange(year,1900,1920) == 1 & `i'_t1 != .
 13. }
 14. 
. foreach q in 1 2 3 23 {
 15. gen sh_euro_segr_en_t`q' = sh_euro_wa_10yr_m * resid_segr_euro_enum_1880_t`q'
 16. gen pr1890_sh_euro_segr_en_t`q' = pr1890_sh_euro_wa_10yr_m * resid_segr_euro_enum_1880_t`q'
 17. }
 18. 
. local regcount = 0
 19. 
. foreach outcome in pres ihsloc dens avgmemb {
 20. 
. local regcount =`regcount' + 1
 21. 
. local var = "afl_comb_`union'_`outcome'"
 22.         
. ***Regression to compute Lewis and Mertens (2022) F-stat (generalization of Montiel-Olea and Pflueger (2013) for mul
> tiple endogenous regressors)
. if c(version) >= 17 & `regcount' == 1 {
 23. qui ivreghdfe `var'                                              (sh_euro_wa_10yr_m sh_euro_segr_en_t23 = ///
>                                                                      pr1890_sh_euro_wa_10yr_m pr1890_sh_euro_segr_en
> _t23) ///
>                                                                           d*_mfgctrl d*_agrctrl d*_minctrl ///
>                                                                          if inrange(year,1900,1920) == 1 & insample_
> balanced == 1, ///
>                                                                          a("${idfe} ${tfe}") cluster("${idfe}") firs
> t
 24.                                                                          
. weakivtest2                                                                      
 25. local fstat_weakiv = string(r(stat),"%6.2fc")                                                    
 26. }
 27. if c(version) < 17 {
 28. local fstat_weakiv = "Stata 17+ required"
 29. }
