. *------------------------------------------------------------------------------*
. * Re-aggregate each census year's county data onto 1930 county boundaries
. *------------------------------------------------------------------------------*
. 
. local baseyear 1930

. 
. numlist "1880(10)1930"

. local allyears `r(numlist)'

. local years_notbase: list allyears - baseyear

. 
. foreach year of local years_notbase {
  2.         
. * Start from the county crosswalk: the area weights mapping each year-<year>
. * county (gisjoin_<year>) onto the 1930 counties it overlaps.
. use "$rawdata/county_crosswalks/crosswalks/CountyToCounty/`baseyear'/Crosswalk_`year'_`baseyear'.dta", clear
  3. keep gisjoin_`year' gisjoin_`baseyear' m*_weight
  4. gen year = `year'
  5. 
. * Attach the county data. Counties match on the NHGIS id (countynhg) for most
. * years; 1890 needs ICPSR ids plus manual corrections for DC and Oklahoma.
. if `year' != 1890 {
  6. merge m:1 gisjoin_`year' using "$intmdata/county_identifiers/countyid_`year'.dta", keepusing(icpsrst icpsrcty gisjoin2)
  7. replace gisjoin2 = real(substr(gisjoin_`year',2,7)) if _merge == 1 & gisjoin_`year' != ""
  8. drop _merge
  9. 
. rename (icpsrst icpsrcty gisjoin2) (stateicp countyicp countynhg)
 10. merge m:1 countynhg year using "$data/county_unadjusted/county_panel_`year'_unadjusted.dta"
 11. drop if _merge == 2
 12. drop _merge
 13. }
 14. 
. if `year' == 1890 {
 15. merge m:1 gisjoin_`year' using "$intmdata/county_identifiers/countyid_`year'.dta", keepusing(icpsrst icpsrcty gisjoin2)
 16. replace gisjoin2 = real(substr(gisjoin_`year',2,7)) if _merge == 1 & gisjoin_`year' != ""
 17. replace icpsrst  = 98 if gisjoin2 == 1100010                                                                    // DC
 18. replace icpsrcty = 10 if gisjoin2 == 1100010
 19. replace icpsrst  = 53 if substr(gisjoin_`year',1,4) == "G405" & _merge == 1             // Oklahoma
 20. replace icpsrcty = real(substr(gisjoin_`year',-4,4)) - 5 if substr(gisjoin_`year',1,4) == "G405" & _merge == 1
 21. drop _merge
 22. 
. rename (icpsrst icpsrcty gisjoin2) (stateicp countyicp countynhg)
 23. merge m:1 stateicp countyicp year using "$data/county_unadjusted/county_panel_`year'_unadjusted.dta"
 24. drop if _merge == 2
 25. drop _merge
 26. }
 27. 
. * Oklahoma's pre-statehood county identifiers do not match the crosswalk for
. * 1880-1900; pull those counties in using the 1910 gisjoin identifiers instead.
. if inlist(`year',1880,1890,1900) == 1 {
 28. 
. drop if stateicp == 53
 29. preserve
 30. use "$rawdata/county_crosswalks/crosswalks/CountyToCounty/`baseyear'/Crosswalk_1910_`baseyear'.dta", clear
 31. keep gisjoin_1910 gisjoin_`baseyear' m*_weight
 32. gen year = `year'
 33. 
. merge m:1 gisjoin_1910 using "$intmdata/county_identifiers/countyid_1910.dta", keepusing(icpsrst icpsrcty gisjoin2)
 34. keep if icpsrst == 53
 35. drop _merge
 36. 
. rename (icpsrst icpsrcty gisjoin2) (stateicp countyicp countynhg)
 37. merge m:1 stateicp countyicp year using "$data/county_unadjusted/county_panel_`year'_unadjusted.dta"
 38. keep if _merge == 3
 39. drop _merge
 40. rename gisjoin_1910 gisjoin_`year'
 41. 
. tempfile statestoadd_`year'
 42. save `statestoadd_`year'', replace
 43. restore
 44. 
. append using `statestoadd_`year''
 45. 
. }
 46. 
. * Area-weighted re-aggregation: each county-level variable is multiplied by its
. * area-share weight and summed (gegen total(), missing) within each 1930 county,
. * giving one row per 1930 county-year; a 1930 county-year with no non-missing
. * contributor for a variable is left missing rather than recorded as a zero. The
. * variables are processed in column chunks (the panel is wide) so the
. * re-aggregation stays within memory; the chunk results are then merged on the
. * 1930 county-year key.
. ds gisjoin* countynhg stateicp countyicp year *_weight, not
 47. local datavars `r(varlist)'
 48. 
. tempfile base
 49. qui save `base'
 50. 
. local chunksize 6000
 51. local nc 0
 52. local c  0
 53. local chunkvars ""
 54. local datavars `datavars' _flush_                       // trailing sentinel flushes the last chunk
 55. 
. foreach var of local datavars {
 56.         if "`var'" != "_flush_" {
 57.                 local chunkvars `chunkvars' `var'
 58.                 local ++nc
 59.         }
 60.         if (`nc' >= `chunksize') | ("`var'" == "_flush_" & `nc' > 0) {
 61.                 local ++c
 62. 
.                 * load this chunk's columns plus keys + weight, area-weight them, and sum
.                 * within each 1930 county; total(),missing leaves all-missing cells missing
.                 use gisjoin_`baseyear' year m1_weight `chunkvars' using `base', clear
 63.                 foreach v of local chunkvars {
 64.                         replace `v' = `v' * m1_weight
 65.                         rename `v' `v'_o
 66.                         bysort gisjoin_`baseyear' year: gegen `v' = total(`v'_o), missing
 67.                         drop `v'_o
 68.                 }
 69.                 gegen tag = tag(gisjoin_`baseyear' year)
 70.                 keep if tag == 1
 71.                 keep gisjoin_`baseyear' year `chunkvars'
 72. 
.                 tempfile chunk`c'
 73.                 qui save `chunk`c''
 74. 
.                 local chunkvars ""
 75.                 local nc 0
 76.         }
 77. }
 78. 
. * merge the chunk results into one row per 1930 county-year
. use `chunk1', clear
 79. forvalues i = 2/`c' {
 80.         merge 1:1 gisjoin_`baseyear' year using `chunk`i'', nogen
 81. }
 82. 
. drop if all_totpop_mw == .
 83. 
. order year, first
 84. 
. save "$data/county_adjusted/county_panel_`year'_county`baseyear'.dta", replace
 85. 
. }

