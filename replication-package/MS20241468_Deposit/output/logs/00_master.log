. local filename = "rob_outliers_depvar"

. 
. preserve 

. 
. foreach fmt in txt xml {        
  2. cap erase "$tables/`filename'.`fmt'"            
  3. }

. 
. foreach outcome in ihsloc dens avgmemb {
  2. local var = "afl_comb_all_`outcome'"
  3. winsor2 `var', cuts(1 99) trim
  4. }

. gen afl_comb_all_pres_tr = (afl_comb_all_dens_tr > 0) if afl_comb_all_dens_tr != .
(11,927 missing values generated)

. 
. foreach outcome in pres ihsloc dens avgmemb {
  2. 
. local var = "afl_comb_all_`outcome'"
  3. 
. local n = 4     
  4.                         
. ivreghdfe `var'_tr                                 (sh_euro_wa_10yr_m  = pr1890_sh_euro_wa_10yr_m) ///
>                                                                    if insample_balanced == 1 & inrange(year,1900,192
> 0) == 1, ///
>                                                                    a("${idfe} ${tfe} ${controls`n'}") cluster("${idf
> e}") first
  5. 
. est store roboutdepvar_`outcome'        
  6.                                                                    
. local fstat = string(`e(widstat)',"%6.2fc")
  7. local obs = string(e(N),"%15.0f")                                                                        
  8. qui sum `var' if e(sample) == 1
  9. if "`var'" == "afl_comb_all_ihsloc" {
 10. qui sum afl_comb_all_locals if e(sample) == 1
 11. }
 12. local depvarmean = string(r(mean),"%6.3fc")
