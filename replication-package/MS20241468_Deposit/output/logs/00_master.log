. 
. *------------------------------------------------------------------------------*
. * Effect on share of delegates by origin
. * Paper: Effect on the Composition of Union Leaders (Table A.7);
. *        outputs share_deleg_{anc,bpl}_{full,restr}sample
. *------------------------------------------------------------------------------*
. 
. foreach type in anc bpl {
  2.         
. if "`type'" == "anc" {
  3. local groups eunw euse
  4. }
  5. if "`type'" == "bpl" {
  6. local groups nat eunw euse
  7. }
  8. 
. foreach union in all {
  9. 
. preserve
 10. 
. rename *afl_del* *afl_all_del*
 11. rename *afl_comb_del* *afl_comb_all_del*
 12. 
. bysort countynhg (year): gegen afl_comb_`union'_del_`type'_min = min(afl_comb_`union'_del_`type'_denom) if insample_
> balanced == 1 & inrange(year,1900,1920) == 1        
 13. 
. * All observations, including county-years with no delegates
. local n = 4
 14. 
. local filename = "share_deleg_`type'_fullsample"
 15. 
. foreach fmt in txt xml {        
 16. cap erase "$tables/`filename'.`fmt'"            
 17. }       
 18.         
. foreach group of local groups {
 19. 
. local var = "afl_comb_`union'_del_sh_`type'_`group'"
 20. 
. ivreghdfe `var'                                          (sh_euro_wa_10yr_m = pr1890_sh_euro_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")    
 21. 
. local fstat = string(`e(widstat)',"%6.2fc")
 22. local obs = string(e(N),"%15.0f")                                                                        
 23. qui sum `var' if e(sample) == 1
 24. local depvarmean = string(r(mean),"%6.3fc")
 25. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 26. local sheuromean = string(r(mean),"%6.3fc")
 27. local sheurostdev = string(r(sd),"%6.3fc")
 28. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se) paren(se) bracket(beta) ///
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*) 
 29.                 
. }
 30.                 
. * Only county-years with delegates in all three years
. local n = 4
 31. 
. local filename = "share_deleg_`type'_restrsample"
 32. 
. foreach fmt in txt xml {        
 33. cap erase "$tables/`filename'.`fmt'"            
 34. }       
 35.                 
. foreach group of local groups {
 36. 
. local var = "afl_comb_`union'_del_sh_`type'_`group'"
 37. 
. ivreghdfe `var'                                          (sh_euro_wa_10yr_m = pr1890_sh_euro_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1 & afl_comb_`union'_del_`type'_min > 0, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")    
 38. 
. local fstat = string(`e(widstat)',"%6.2fc")
 39. local obs = string(e(N),"%15.0f")                                                                        
 40. qui sum `var' if e(sample) == 1
 41. local depvarmean = string(r(mean),"%6.3fc")
 42. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 43. local sheuromean = string(r(mean),"%6.3fc")
 44. local sheurostdev = string(r(sd),"%6.3fc")
 45. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se) paren(se) bracket(beta) ///
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*) 
 46.                                                                         
. }
 47.                                                                         
. foreach fmt in txt {    
 48. cap erase "$tables/`filename'.`fmt'"            
 49. }       
 50. 
. restore
 51. 
. }
 52. 
. }
