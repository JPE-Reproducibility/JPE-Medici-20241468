. 
. *------------------------------------------------------------------------------*
. * Heterogeneity by strength of socialist parties in the origin country
. * Paper: Heterogeneous Effects by Support for Socialist Parties in Country of Origin (Table A.9);
. *        outputs het_socparteurope10_all, het_socparteurope20_all
. *------------------------------------------------------------------------------*
. 
. foreach q in 10 20 {
  2.         
. foreach union in all {
  3. 
. local filename = "het_socparteurope`q'_`union'"
  4. local n = 4     
  5. 
. foreach fmt in txt xml {        
  6. cap erase "$tables/`filename'.`fmt'"            
  7. }
  8. 
. preserve
  9. 
. foreach outcome in pres ihsloc dens avgmemb {   
 10. 
. local var = "afl_comb_`union'_`outcome'"
 11. 
. ivreghdfe `var'                                          (sh_soc`q'_wa_10yr_m sh_nonsoc`q'_wa_10yr_m = ///
>                                                                           pr1890_sh_soc`q'_wa_10yr_m pr1890_sh_nonso
> c`q'_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first
 12. 
. local obs = string(e(N),"%15.0f")                                                                        
 13. local fstat = string(`e(widstat)',"%6.2fc")
 14. mat first = e(first)
 15. local partfstat1 = string(first[8,1],"%6.2fc")
 16. local partfstat2 = string(first[8,2],"%6.2fc")
 17. qui sum `var' if e(sample) == 1
 18. if "`outcome'" == "ihsloc" {
 19. qui sum afl_comb_`union'_locals if e(sample) == 1
 20. } 
 21. local depvarmean = string(r(mean),"%6.3fc")
 22. qui sum sh_soc`q'_wa_10yr_m if e(sample) == 1
 23. local sheuromean1 = string(r(mean),"%6.3fc")
 24. qui sum sh_nonsoc`q'_wa_10yr_m if e(sample) == 1
 25. local sheuromean2 = string(r(mean),"%6.3fc")
 26. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se beta) bracket(beta) paren(se) /
> //
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean Socialist, "`sheuromean1'", ///
>                                                                         Imm. Share mean Non-socialist, "`sheuromean2
> '", KP F-stat, "`fstat'", ///
>                                                                         SW F-stat 1, "`partfstat1'", SW F-stat 2, "`
> partfstat2'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_*) 
 27.                                                                 
. }
 28. 
. restore
 29. 
. foreach fmt in txt {    
 30. cap erase "$tables/`filename'.`fmt'"            
 31. }
 32. 
. }
 33. 
. }
