. *------------------------------------------------------------------------------*
. * Heterogeneity by immigrant country of origin
. * Paper: Heterogeneous Effects by Origin of Immigrants (Table 7); output byorigin_all
. *------------------------------------------------------------------------------*
. 
. foreach union in all {
  2. 
. local n = 4     
  3. local filename = "byorigin_`union'"
  4. 
. foreach fmt in txt xml {        
  5. cap erase "$tables/`filename'.`fmt'"            
  6. }
  7. 
. local regcount = 0
  8. 
. foreach outcome in pres ihsloc dens avgmemb {
  9. 
. local regcount = `regcount' + 1
 10. 
. preserve        
 11. 
. local var = "afl_comb_`union'_`outcome'"
 12. 
. ***Regression to compute Lewis and Mertens (2022) F-stat (generalization of Montiel-Olea and Pflueger (2013) for mul
> tiple endogenous regressors)
. if c(version) >= 17 & `regcount' == 1 {
 13. qui ivreghdfe `var'                                              (sh_newsend_wa_10yr_m sh_oldsend_wa_10yr_m = pr1
> 890_sh_newsend_wa_10yr_m pr1890_sh_oldsend_wa_10yr_m) ///
>                                                                           d*_mfgctrl d*_agrctrl d*_minctrl ///
>                                                                          if inrange(year,1900,1920) == 1 & insample_
> balanced == 1, ///
>                                                                          a("${idfe} ${tfe}") cluster("${idfe}") firs
> t
 14.                                                                          
. weakivtest2                                                                      
 15. local fstat_weakiv = string(r(stat),"%6.2fc")                                                    
 16. }
 17. if c(version) < 17 {
 18. local fstat_weakiv = "Stata 17+ required"
 19. }
 20. 
. ivreghdfe `var'                                  (sh_newsend_wa_10yr_m sh_oldsend_wa_10yr_m = pr1890_sh_newsend_wa_1
> 0yr_m pr1890_sh_oldsend_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first
 21. 
. local obs = string(e(N),"%15.0f")                                                                        
 22. local fstat = string(`e(widstat)',"%6.2fc")
 23. mat first = e(first)
 24. local partfstat1 = string(first[8,1],"%6.2fc")
 25. local partfstat2 = string(first[8,2],"%6.2fc")
 26. qui sum `var' if e(sample) == 1
 27. if "`outcome'" == "ihsloc" {
 28. qui sum afl_comb_`union'_locals if e(sample) == 1
 29. } 
 30. local depvarmean = string(r(mean),"%6.3fc")
 31. qui sum sh_newsend_wa_10yr_m if e(sample) == 1
 32. local shseeuromean = string(r(mean),"%6.3fc")
 33. qui sum sh_oldsend_wa_10yr_m if e(sample) == 1
 34. local shnweuromean = string(r(mean),"%6.3fc")
 35. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se beta) bracket(beta) paren(se) /
> //
>                                                                         addtext(Outcome mean, "`depvarmean'", ///
>                                                                         Imm. Share S/E Europe mean, "`shseeuromean'"
> , ///
>                                                                         Imm. Share N/W Europe mean, "`shnweuromean'"
> , ///                                                                       
>                                                                         KP F-stat, "`fstat'", ///
>                                                                         LM F-stat, "`fstat_weakiv'", ///
>                                                                         SW F-stat 1, "`partfstat1'", SW F-stat 2, "`
> partfstat2'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_*) 
 36. restore
 37.                                                                         
. }
 38. 
. foreach fmt in txt {    
 39. cap erase "$tables/`filename'.`fmt'"            
 40. }
 41. 
. }       
