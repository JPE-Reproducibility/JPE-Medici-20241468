. *------------------------------------------------------------------------------*
. * Extract county identifiers from the Ferrara et al. (2022) crosswalks
. *------------------------------------------------------------------------------*
. 
. * For each census year, pull the county identifiers (ICPSR and NHGIS codes)
. * from the county crosswalk files into a slim lookup used in the adjustment below.
. forvalues y = 1880(10)1920 {
  2. use "$rawdata/county_crosswalks/crosswalks/CountyToCounty/`y'/Identifiers_`y'.dta", clear
  3. rename decade year
  4. keep year nhgisnam icpsrst icpsrcty icpsrnam gisjoin gisjoin2 shape_area shape_len cnty_area_`y' gisjoin_`y'
  5. drop if icpsrst == .
  6. save "$intmdata/county_identifiers/countyid_`y'.dta", replace
  7. }
