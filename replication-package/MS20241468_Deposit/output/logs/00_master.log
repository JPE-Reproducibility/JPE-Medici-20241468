. 
. *------------------------------------------------------------------------------*
. * Heterogeneity by the number of other unions' branches (KoL, IWW)
. * Paper: Heterogeneous Effects by the Number of Other Unions' Branches (Table A.10); outputs het_KOL, het_IWW
. *------------------------------------------------------------------------------*
. 
. foreach unionhet in KOL IWW {
  2. 
. local n = 4
  3. 
. local filename = "het_`unionhet'"
  4. 
. foreach fmt in txt xml {        
  5. cap erase "$tables/`filename'.`fmt'"            
  6. }
  7. 
. preserve
  8. 
. if "`unionhet'" == "IWW" {
  9. gen sheuro_IWW = sh_euro_wa_10yr_m * asinh(locals_IWW_0617)
 10. gen pr1890sheuro_IWW = pr1890_sh_euro_wa_10yr_m * asinh(locals_IWW_0617)
 11. }
 12. if "`unionhet'" == "KOL" {
 13. gen sheuro_KOL = sh_euro_wa_10yr_m * asinh(locals_kol_1880)
 14. gen pr1890sheuro_KOL = pr1890_sh_euro_wa_10yr_m * asinh(locals_kol_1880)
 15. }
 16. 
. foreach outcome in pres ihsloc dens avgmemb {
 17. 
. local union = "all"
 18. local var = "afl_comb_`union'_`outcome'"
 19. 
. ivreghdfe `var'                                          (sh_euro_wa_10yr_m sheuro_`unionhet' = ///
>                                                                           pr1890_sh_euro_wa_10yr_m pr1890sheuro_`uni
> onhet') ///
>                                                                           if insample_balanced == 1 & inrange(year,1
> 900,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first
 20. 
. local obs = string(e(N),"%15.0f")                                                                        
 21. local fstat = string(`e(widstat)',"%6.2fc")
 22. mat first = e(first)
 23. local partfstat1 = string(first[8,1],"%6.2fc")
 24. local partfstat2 = string(first[8,2],"%6.2fc")
 25. qui sum `var' if e(sample) == 1
 26. if "`outcome'" == "ihsloc" {
 27. qui sum afl_comb_`union'_locals if e(sample) == 1
 28. } 
 29. 
. local depvarmean = string(r(mean),"%6.3fc")
 30. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 31. local sheuromean = string(r(mean),"%6.3fc")
 32. 
. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se) bracket(beta) paren(se) ///
>                                                                         addtext(Outcome mean, "`depvarmean'", ///
>                                                                         Share Immigrants, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", ///
>                                                                         SW F-stat 1, "`partfstat1'", SW F-stat 2, "`
> partfstat2'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_* sh*) 
 33. 
. } 
 34. 
. restore
 35. 
. foreach fmt in txt {    
 36. cap erase "$tables/`filename'.`fmt'"            
 37. }
 38. 
. }
