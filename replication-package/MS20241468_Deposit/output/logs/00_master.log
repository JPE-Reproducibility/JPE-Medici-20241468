. *------------------------------------------------------------------------------*
. * Controlling for additional baseline characteristics
. * Paper: Robustness Check -- Controlling for Additional Baseline Characteristics (Figure 4); output rob_controls.pdf
. *------------------------------------------------------------------------------*
. 
. foreach outcome in pres ihsloc dens avgmemb  {
  2. 
. local filename = "rob_controls_`outcome'"
  3. local n = 4     
  4. 
. foreach fmt in txt xml {        
  5. cap erase "$tables/`filename'.`fmt'"            
  6. }
  7. 
. preserve
  8. 
. egen demshare_1890_avg = rowmean(demshare_1888 demshare_1892)
  9. gen afloccs_share_m_1880 = all_lf_afloccs_m_1880 / all_lf_tot_m_1880
 10. gen mfgout_growth_1890 = (mfgout_ip_defl_1890 - mfgout_ip_defl_1880) / mfgout_ip_defl_1880
 11. 
. local robcontrols " "year#c.urban_share_mw_1890" "year#c.log_popdens_mw_1890" "year#c.imm_share_mw_1890" "year#c.imm
> _share_mw_1880" "year#c.black_share_mw_1890" "year#c.agric_share_m_1880 year#c.mining_share_m_1880 year#c.constr_sha
> re_m_1880 year#c.mfg_share_m_1880 year#c.transp_share_m_1880 year#c.trade_share_m_1880 year#c.fin_share_m_1880 year#
> c.biz_share_m_1880 year#c.persserv_share_m_1880 year#c.ent_share_m_1880 year#c.profserv_share_m_1880 year#c.pubadm_s
> hare_m_1880" "year#c.highskill2_share_m_1880 year#c.midskill2_share_m_1880 year#c.lowskill_share_m_1880" "year#c.log
> _all_occsc_m_1880" "year#c.mfgout_growth_1890" "year#c.rail_conn_1890" "year#c.demshare_1890_avg" "
 12. 
. local var = "afl_comb_all_`outcome'"
 13. 
. ivreghdfe "`var'"                                        (sh_euro_wa_10yr_m = pr1890_sh_euro_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")  
 14.                                                                          
. est store baseline_`outcome'
 15. local fstat = string(`e(widstat)',"%6.2fc")
 16. local obs = string(e(N),"%15.0f")                                                                        
 17. qui sum `var' if e(sample) == 1
 18. if "`var'" == "afl_comb_all_ihsloc" {
 19. qui sum afl_comb_all_locals if e(sample) == 1
 20. }
 21. local depvarmean = string(r(mean),"%6.3fc")
 22. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 23. local sheuromean = string(r(mean),"%6.3fc")
 24. local sheurostdev = string(r(sd),"%6.3fc")
 25. 
. local i = 0
 26. foreach robcontrol of local robcontrols {    
 27. 
. local i = `i' + 1
 28. local n = 4
 29. 
. ivreghdfe "`var'"                                  (sh_euro_wa_10yr_m  = pr1890_sh_euro_wa_10yr_m) ///
>                                                                    if insample_balanced == 1 & inrange(year,1900,192
> 0) == 1, ///
>                                                                    a("${idfe} ${tfe} ${controls`n'}" `robcontrol') c
> luster("${idfe}")   
 30. 
. est store robctrl_`outcome'_`i'                                                            
 31. local fstat = string(`e(widstat)',"%6.2fc")
 32. local obs = string(e(N),"%15.0f")                                                                        
 33. qui sum `var' if e(sample) == 1
 34. if "`var'" == "afl_comb_all_ihsloc" {
 35. qui sum afl_comb_all_locals if e(sample) == 1
 36. }
 37. local depvarmean = string(r(mean),"%6.3fc")
 38. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 39. local sheuromean = string(r(mean),"%6.3fc")
 40. local sheurostdev = string(r(sd),"%6.3fc")
 41.                                                                 
. }
 42. restore
 43. 
. }
