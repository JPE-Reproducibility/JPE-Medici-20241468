. *------------------------------------------------------------------------------*
. * County panels for 1880, 1900, 1910, 1920
. *------------------------------------------------------------------------------*
. 
. foreach year in 1880 1900 1910 1920 {
  2. 
. * Base: IPUMS labor-market aggregates (b1). Add population counts (b5) and the
. * manufacturing census (b7).
. use if year == `year' using "$intmdata/IPUMS_`year'_county.dta", clear
  3. 
. merge 1:1 year stateicp countyicp using "$intmdata/IPUMS_`year'_population_county.dta"
  4. drop if year != `year'
  5. drop _merge
  6. 
. merge 1:1 year stateicp countyicp using "$intmdata/mfg_census.dta", keepusing(mfglabor_* mfgwages_* mfgout mfgestab)
  7. drop if year != `year'
  8. drop if _merge == 2
  9. drop _merge
 10. 
. * The 1900 IPUMS full count has no NHGIS county identifier (countynhg); merge
. * it in from the dedicated crosswalk.
. if `year' == 1900 {
 11. merge 1:1 year stateicp countyicp using "$intmdata/xwalk_1900_countynhg_countyicp.dta", keepusing(countynhg)
 12. drop if _merge == 2
 13. drop _merge
 14. }
 15. 
. * Immigrant counts by birthplace country (b2). A county absent from the
. * immigrant file is a true zero; build the men+women (and recent-arrival)
. * totals from the men's and women's counts.
. if `year' != 1880 {
 16. merge 1:1 year stateicp countyicp using "$intmdata/IPUMS_`year'_euroimm_county.dta"
 17. foreach country in denmark finland norway sweden uk ireland oth_northeu ///
>                                    belgium france luxemb nether switz oth_westeu ///
>                                    italy gr_pt_es oth_southeu ///
>                                    aus_hung czech germany poland oth_easteu oth_centereu ///
>                                    russia oth_russeu {
 18. foreach s in m w {
 19. replace `country'_`s' = 0 if _merge == 1 & `country'_`s' == .
 20. }
 21. gen `country'_mw      = `country'_m + `country'_w
 22. gen `country'_10yr_mw = `country'_10yr_m + `country'_10yr_w
 23. }
 24. drop _merge
 25. }
 26. 
. if `year' == 1880 {
 27. 
. * Residential-segregation counts (b6).
. merge 1:1 year stateicp countyicp using "$intmdata/resid_segr_1880.dta"
 28. drop if _merge == 2
 29. drop _merge
 30. 
. * Immigrant counts by birthplace country (b2). The 1880 census has no
. * year-of-immigration, so there are no recent-arrival counts -- only the
. * men+women total is built.
. merge 1:1 year stateicp countyicp using "$intmdata/IPUMS_`year'_euroimm_county.dta"
 31. foreach country in denmark finland norway sweden uk ireland oth_northeu ///
>                                    belgium france luxemb nether switz oth_westeu ///
>                                    italy gr_pt_es oth_southeu ///
>                                    aus_hung czech germany poland oth_easteu oth_centereu ///
>                                    russia oth_russeu {
 32. foreach s in m w {
 33. replace `country'_`s' = 0 if _merge == 1 & `country'_`s' == .
 34. }
 35. gen `country'_mw = `country'_m + `country'_w
 36. }
 37. drop _merge
 38. 
. }
 39. 
. * Presidential-election returns: the decade's elections, plus the 1856
. * American-Party (Know-Nothing) cross-section.
. if `year' == 1900 {
 40. merge 1:1 year stateicp countyicp using "$intmdata/electionresults_1886-1924_county.dta", keepusing(*vote_1896 *vote_1900 *vote_1904)
 41. drop if _merge == 2
 42. drop _merge
 43. merge m:1 stateicp countyicp using "$intmdata/electionresults_1856_county.dta", keepusing(*vote_1856)
 44. drop if _merge == 2
 45. drop _merge
 46. }
 47. if `year' == 1910 {
 48. merge 1:1 year stateicp countyicp using "$intmdata/electionresults_1886-1924_county.dta", keepusing(*vote_1908 *vote_1912)
 49. drop if _merge == 2
 50. drop _merge
 51. merge m:1 stateicp countyicp using "$intmdata/electionresults_1856_county.dta", keepusing(*vote_1856)
 52. drop if _merge == 2
 53. drop _merge
 54. }
 55. if `year' == 1920 {
 56. merge 1:1 year stateicp countyicp using "$intmdata/electionresults_1886-1924_county.dta", keepusing(*vote_1916 *vote_1920 *vote_1924)
 57. drop if _merge == 2
 58. drop _merge
 59. merge m:1 stateicp countyicp using "$intmdata/electionresults_1856_county.dta", keepusing(*vote_1856)
 60. drop if _merge == 2
 61. drop _merge
 62. }
 63. 
. * Occupation counts (b3) and IND1950 industry counts (b4).
. merge 1:1 year stateicp countyicp using "$intmdata/IPUMS_`year'_occ_county_m.dta"
 64. drop _merge
 65. 
. merge 1:1 year stateicp countyicp using "$intmdata/IPUMS_`year'_ind1950counts_county.dta"
 66. drop _merge
 67. 
. * Correct miscoded / missing NHGIS county identifiers so the border
. * adjustment in 1c matches counties cleanly.
. if inlist(`year',1910,1920) == 1 {
 68. replace countynhg = 5106500 if countynhg == 5100550 & statefip == 51 & countyicp == 6500
 69. }
 70. 
. if `year' == 1900 {
 71. replace countynhg = 5100130 if countynhg == 5100035 & countyicp == 130
 72. replace countynhg = 5105100 if countynhg == 5100035 & countyicp == 5100
 73. merge m:1 stateicp using "$intmdata/xwalk_statefip_stateicp.dta", keepusing(statefip)
 74. drop if _merge == 2
 75. drop _merge
 76. replace countynhg = (statefip * 100000) + countyicp if countynhg == . & inlist(stateicp,33,35,37,40,49,53) & countyicp < 9000
 77. }
 78. 
. drop statefip
 79. 
. sort year stateicp countyicp
 80. order year countynhg stateicp countyicp, first
 81. 
. * Drop counties with no NHGIS identifier -- they cannot be border-adjusted.
. drop if countynhg == . | countynhg == 9999999
 82. 
. drop if year != `year'
 83. 
. save "$data/county_unadjusted/county_panel_`year'_unadjusted.dta", replace
 84. 
. }

