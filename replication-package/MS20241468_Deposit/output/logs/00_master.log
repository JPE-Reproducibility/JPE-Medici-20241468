. *------------------------------------------------------------------------------*
. * Heterogeneity by Know-Nothing vote share
. * Paper: Heterogeneous Effects by Attitudes Towards Immigration, Panel A
. *        (Table 8; terciles in Table A.6);
. *        outputs het_knownotshare_all, het_knownotshare_all_alt
. *------------------------------------------------------------------------------*
. 
. foreach union in all {
  2.         
. local n = 4     
  3. 
. local filename = "het_knownotshare_`union'"
  4. foreach fmt in txt xml {        
  5. cap erase "$tables/`filename'.`fmt'"            
  6. cap erase "$tables/`filename'_alt.`fmt'"                        
  7. }
  8.         
. preserve
  9.         
. foreach i in knownotshare_1856 {
 10. xtile `i'_t = `i' if insample_balanced == 1 & inrange(year,1900,1920) == 1, n(3)
 11. tab `i'_t if insample_balanced == 1 & inrange(year,1900,1920) == 1, gen(`i'_t)
 12. gen `i'_t23 = (`i'_t2 == 1 | `i'_t3 == 1) if insample_balanced == 1 & inrange(year,1900,1920) == 1 & `i'_t1 != .
 13. }       
 14. 
. foreach q in 1 2 3 23 {
 15. gen sh_euro_knownot_t`q' = sh_euro_wa_10yr_m * knownotshare_1856_t`q'
 16. gen pr1890_sh_euro_knownot_t`q' = pr1890_sh_euro_wa_10yr_m * knownotshare_1856_t`q'
 17. }
 18. 
. local regcount = 0
 19. 
. foreach outcome in pres ihsloc dens avgmemb {
 20.         
. local regcount = `regcount' + 1
 21. 
. local var = "afl_comb_`union'_`outcome'"                                                
 22. 
. ***Regression to compute Lewis and Mertens (2022) F-stat (generalization of Montiel-Olea and Pflueger (2013) for mul
> tiple endogenous regressors)
. if c(version) >= 17 & `regcount' == 1 {
 23. qui ivreghdfe `var'                                              (sh_euro_wa_10yr_m sh_euro_knownot_t23 = ///
>                                                                      pr1890_sh_euro_wa_10yr_m pr1890_sh_euro_knownot
> _t23) ///
>                                                                           d*_mfgctrl d*_agrctrl d*_minctrl ///
>                                                                          if inrange(year,1900,1920) == 1 & insample_
> balanced == 1, ///
>                                                                          a("${idfe} ${tfe}") cluster("${idfe}") firs
> t
 24.                                                                          
. weakivtest2                                                                      
 25. local fstat_weakiv = string(r(stat),"%6.2fc")                                                    
 26. }
 27. if c(version) < 17 {
 28. local fstat_weakiv = "Stata 17+ required"
 29. }
 30. 
. ***Regressions t2+t3 vs. t1
. ivreghdfe `var'                                          (sh_euro_wa_10yr_m sh_euro_knownot_t23 = ///
>                                                                      pr1890_sh_euro_wa_10yr_m pr1890_sh_euro_knownot
> _t23) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first  
 31. est store knownot_`union'_`outcome'
 32. 
. local obs = string(e(N),"%15.0f")                                                                        
 33. local fstat = string(`e(widstat)',"%6.2fc")
 34. mat first = e(first)
 35. local partfstat1 = string(first[8,1],"%6.2fc")
 36. local partfstat2 = string(first[8,2],"%6.2fc")
 37. qui sum `var' if e(sample) == 1
 38. if "`outcome'" == "ihsloc" {
 39. qui sum afl_comb_`union'_locals if e(sample) == 1
 40. } 
 41. local depvarmean = string(r(mean),"%6.3fc")
 42. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 43. local sheuromean = string(r(mean),"%6.3fc")
 44. local sheurostdev = string(r(sd),"%6.3fc")
 45. nlcom lc: _b[sh_euro_wa_10yr_m] + _b[sh_euro_knownot_t23], post
 46. local coef_lc = string(_b[lc],"%6.3fc")
 47. local se_lc = string(_se[lc],"%6.3fc")
 48. est restore knownot_`union'_`outcome'                                                                    
 49. 
. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se) bracket(beta) paren(se) ///
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", ///
>                                                                         LM F-stat, "`fstat_weakiv'", ///
>                                                                         SW F-stat 1, "`partfstat1'", SW F-stat 2, "`
> partfstat2'", ///
>                                                                         "${fetext}, ${controlstext`n'}", ///
>                                                                         [1] + [2], "`coef_lc'", s.e., "`se_lc'") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*) 
 50.                                                                                                                  
>                        
. ***Regressions t1, t2, t3
. ivreghdfe `var'                                          (sh_euro_knownot_t1 sh_euro_knownot_t2 sh_euro_knownot_t3 =
>  ///
>                                                                      pr1890_sh_euro_knownot_t1 pr1890_sh_euro_knowno
> t_t2 pr1890_sh_euro_knownot_t3) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first
 51. 
. local obs = string(e(N),"%15.0f")                                                                        
 52. local fstat = string(`e(widstat)',"%6.2fc")
 53. mat first = e(first)
 54. local partfstat1 = string(first[8,1],"%6.2fc")
 55. local partfstat2 = string(first[8,2],"%6.2fc")
 56. local partfstat3 = string(first[8,3],"%6.2fc")
 57. qui sum `var' if e(sample) == 1
 58. if "`outcome'" == "ihsloc" {
 59. qui sum afl_comb_`union'_locals if e(sample) == 1
 60. } 
 61. local depvarmean = string(r(mean),"%6.3fc")
 62. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 63. local sheuromean = string(r(mean),"%6.3fc")
 64. local sheurostdev = string(r(sd),"%6.3fc")
 65. outreg2 using "$tables/`filename'_alt", append dec(3) label nor2 nocons stats(coef se) bracket(beta) paren(se) //
> /
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", ///
>                                                                         SW F-stat 1, "`partfstat1'", SW F-stat 2, "`
> partfstat2'", SW F-stat 3, "`partfstat3'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*) 
 66.                                                                                                                  
>                                
. }
 67. 
. restore
 68. 
. foreach fmt in txt {    
 69. cap erase "$tables/`filename'.`fmt'"            
 70. cap erase "$tables/`filename'_alt.`fmt'"                
 71. }
 72. 
. }       

