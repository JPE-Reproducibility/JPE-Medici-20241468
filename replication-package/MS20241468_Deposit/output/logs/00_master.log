. 
. global idfe countynhg_1930

. global tfe  year

. global fetext "County FE, Y, Year FE, Y"

. 
. drop coalmines_d*

. 
. gen coalmines_perpop_1890 = coalmines_tot_1890 / (all_totpop_mw_1890/1000)
