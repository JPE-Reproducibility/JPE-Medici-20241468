. *------------------------------------------------------------------------------*
. * Heterogeneity by strength of the labor movement in the origin country
. * Paper: Heterogeneous Effects by Strength of Labor Movement in Country of Origin (Table A.8); output het_unionseuro
> pe_all
. *------------------------------------------------------------------------------*
. 
. foreach union in all {
  2. 
. local filename = "het_unionseurope_`union'"
  3. local n = 4     
  4. 
. foreach fmt in txt xml {        
  5. cap erase "$tables/`filename'.`fmt'"            
  6. }
  7. 
. preserve
  8. 
. foreach outcome in pres ihsloc dens avgmemb {   
  9. 
. local var = "afl_comb_`union'_`outcome'"
 10. 
. ivreghdfe `var'                                          (sh_unionh_wa_10yr_m sh_unionl_wa_10yr_m = pr1890_sh_unionh
> _wa_10yr_m pr1890_sh_unionl_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}") first
 11. 
. local obs = string(e(N),"%15.0f")                                                                        
 12. local fstat = string(`e(widstat)',"%6.2fc")
 13. mat first = e(first)
 14. local partfstat1 = string(first[8,1],"%6.2fc")
 15. local partfstat2 = string(first[8,2],"%6.2fc")
 16. qui sum `var' if e(sample) == 1
 17. if "`outcome'" == "ihsloc" {
 18. qui sum afl_comb_`union'_locals if e(sample) == 1
 19. } 
 20. local depvarmean = string(r(mean),"%6.3fc")
 21. qui sum sh_unionh_wa_10yr_m if e(sample) == 1
 22. local sheuromean1 = string(r(mean),"%6.3fc")
 23. qui sum sh_unionl_wa_10yr_m if e(sample) == 1
 24. local sheuromean2 = string(r(mean),"%6.3fc")
 25. outreg2 using "$tables/`filename'", append dec(3) label nor2 nocons stats(coef se beta) bracket(beta) paren(se) /
> //
>                                                                         addtext(Outcome mean, "`depvarmean'", Imm. S
> hare mean UK-Ireland, "`sheuromean1'", ///
>                                                                         Imm. Share mean Other countries, "`sheuromea
> n2'", KP F-stat, "`fstat'", ///
>                                                                         SW F-stat 1, "`partfstat1'", SW F-stat 2, "`
> partfstat2'", ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_*) 
 26.                                                                 
. }
 27. 
. restore
 28. 
. foreach fmt in txt {    
 29. cap erase "$tables/`filename'.`fmt'"            
 30. }
 31. 
. }
