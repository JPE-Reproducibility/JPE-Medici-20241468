. 
. *------------------------------------------------------------------------------*
. * Shares of delegates by origin
. * Paper: Shares of Union Leaders by Origin and Ancestry (Figure A.5); output share_deleg.pdf
. *------------------------------------------------------------------------------*
. foreach union in afl_comb {
  2.         
. preserve
  3. 
. keep if inrange(year,1900,1920) == 1 & insample_balanced == 1 & inrange(year,1900,1920) == 1
  4. 
. collapse (sum) `union'_del_bpl_nat `union'_del_bpl_oth `union'_del_bpl_eu `union'_del_bpl_eunw `union'_del_bpl_euse 
> `union'_del_bpl_denom `union'_del_anc_oth `union'_del_anc_eu `union'_del_anc_eunw `union'_del_anc_euse `union'_del_a
> nc_denom, by(year)
  5. foreach group in nat oth eu eunw euse {
  6. gen `union'_del_sh_bpl_`group' = `union'_del_bpl_`group' / `union'_del_bpl_denom
  7. }
  8. foreach group in oth eu eunw euse {
  9. gen `union'_del_sh_anc_`group' = `union'_del_anc_`group' / `union'_del_anc_denom
 10. }
 11. 
. sum *sh_bpl_* if year == 1900
 12. sum *sh_bpl_* if year == 1910
 13. sum *sh_bpl_* if year == 1920
 14. 
. sum *sh_anc_* if year == 1900
 15. sum *sh_anc_* if year == 1910
 16. sum *sh_anc_* if year == 1920
 17. 
. graph bar `union'_del_sh_bpl_nat `union'_del_sh_bpl_eunw `union'_del_sh_bpl_euse, ///
>                   over(year, gap(250) label(labsize(medsmall))) ///
>                   legend(order(1 "U.S.-Born" 2 "N/W Europe" 3 "S/E Europe") size(medsmall) rows(1) holes(2) region(l
> style(none))) ///
