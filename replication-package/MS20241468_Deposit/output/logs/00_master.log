  7. 
.     foreach group in oth eu eunw euse {
  8.         gen afl_comb_del_`j'_`group' = afl_del_`j'_`group' + ///
>                                        afl_comb_ubc_del_`j'_`group'   - afl_ubc_del_`j'_`group' + ///
>                                        afl_comb_iam_del_`j'_`group'   - afl_iam_del_`j'_`group' + ///
