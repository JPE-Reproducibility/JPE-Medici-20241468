. replace county = county / 10                                                                                                    // recover the county FIPS 
> code
variable county was int now float
(18,385 real changes made)

. rename (gisjoin2 cnty_area_`baseyear' icpsrst icpsrcty state county) ///
>        (countynhg_`baseyear' area_`baseyear' stateicp countyicp statefip countyfip)

. 
. * Attach the county centroids.
. merge m:1 gisjoin_`baseyear' using "$rawdata/county_crosswalks/crosswalks/County-CD-centroid-lat-lon/lat_lon_coordinates_county/Counties_`baseyear'_xy.dta"
> , keepusing(centroid*)

