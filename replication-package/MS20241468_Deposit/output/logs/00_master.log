. 
. * Build temperature shock indicators per season: a station-year is hit with
. * a positive (negative) shock at level k if its standardized temperature is
. * in the half-open interval (k, k+1] (resp. [-(k+1), -k)).
. foreach season_code in 16 14 15 13 {
  2. 
.     if `season_code' == 16 local suffix = "f"   // Fall
  3.     if `season_code' == 14 local suffix = "s"   // Spring
  4.     if `season_code' == 15 local suffix = "su"  // Summer
  5.     if `season_code' == 13 local suffix = "w"   // Winter
  6. 
.     cap drop temp_cstd
  7.     bysort ISO_ALPHA3: center temp if season == `season_code', standardize gen(temp_cstd)
  8. 
.     gen tempshock_pos1`suffix' = (temp_cstd > 1 & temp_cstd <= 2 & temp_cstd != .)
  9.     gen tempshock_pos2`suffix' = (temp_cstd > 2 & temp_cstd <= 3 & temp_cstd != .)
 10.     gen tempshock_pos3`suffix' = (temp_cstd > 3 & temp_cstd != .)
 11. 
.     gen tempshock_neg1`suffix' = (temp_cstd < -1 & temp_cstd >= -2 & temp_cstd != .)
 12.     gen tempshock_neg2`suffix' = (temp_cstd < -2 & temp_cstd >= -3 & temp_cstd != .)
 13.     gen tempshock_neg3`suffix' = (temp_cstd < -3 & temp_cstd != .)
 14. 
. }
