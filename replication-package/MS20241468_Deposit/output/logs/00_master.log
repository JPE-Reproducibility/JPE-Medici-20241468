. 
. foreach fmt in txt {    
  2. cap erase "$tables/firststage.`fmt'"            
  3. }

. 
. *------------------------------------------------------------------------------*
. * Baseline regressions (OLS, reduced form, 2SLS)
. * Paper: The Effect of Immigration on Organized Labor (Table 3);
. *        outputs baseline_ols, baseline_redform, baseline_2sls
. *------------------------------------------------------------------------------*
. local filename = "baseline"

. 
. foreach fmt in txt xml {        
  2. cap erase "$tables/`filename'_ols.`fmt'"        
  3. cap erase "$tables/`filename'_redform.`fmt'"                                    
  4. cap erase "$tables/`filename'_2sls.`fmt'"       
  5. }

. 
. local n = 4     

. 
. foreach outcome in pres ihsloc dens avgmemb {
  2. 
. local union = "all"             
  3. local var = "afl_comb_`union'_`outcome'"                
  4.         
. *OLS
. reghdfe `var'                                            sh_euro_wa_10yr_m ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")  
  5. 
. local obs = string(e(N),"%15.0f")                       
  6. qui sum `var' if e(sample) == 1
  7. if "`outcome'" == "ihsloc" {
  8. qui sum afl_comb_`union'_locals if e(sample) == 1
  9. } 
 10. local depvarmean = string(r(mean),"%6.3fc")
 11. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 12. local sheuromean = string(r(mean),"%6.3fc")
 13. local sheurostdev = string(r(sd),"%6.3fc")
 14. outreg2 using "$tables/`filename'_ols", noobs append dec(3) label nor2 nocons stats(coef se) paren(se) ///
>                                                                         addtext("Nr. observations", "`obs'", Dep. va
> r. mean, "`depvarmean'", ///
>                                                                         Indep. var. mean, "`sheuromean'", ///
>                                                                         Estimator, OLS, ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*)
 15.                                                         
. *Reduced form
. reghdfe `var'                                            pr1890_sh_euro_wa_10yr_m ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")  
 16. 
. local obs = string(e(N),"%15.0f")                                                                        
 17. qui sum `var' if e(sample) == 1
 18. if "`outcome'" == "ihsloc" {
 19. qui sum afl_comb_`union'_locals if e(sample) == 1
 20. } 
 21. local depvarmean = string(r(mean),"%6.3fc")
 22. qui sum pr1890_sh_euro_wa_10yr_m if e(sample) == 1
 23. local indepvarmean = string(r(mean),"%6.3fc")
 24. local indepvarstdev = string(r(sd),"%6.3fc")
 25. outreg2 using "$tables/`filename'_redform", noobs append dec(3) label nor2 nocons stats(coef se) paren(se) ///
>                                                                         addtext("Nr. observations ", "`obs'", Dep. v
> ar. mean, "`depvarmean'", ///
>                                                                         Indep. var. mean, "`sheuromean'", ///
>                                                                         Estimator, Reduced Form, ///
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*)   
>                                                                     
 26.                                                         
. *2SLS
. ivreghdfe `var'                                          (sh_euro_wa_10yr_m = pr1890_sh_euro_wa_10yr_m) ///
>                                                                          if insample_balanced == 1 & inrange(year,19
> 00,1920) == 1, ///
>                                                                          a("${idfe} ${tfe} ${controls`n'}") cluster(
> "${idfe}")  
 27. 
. local obs = string(e(N),"%15.0f")                                                                        
 28. local fstat = string(`e(widstat)',"%6.2fc")
 29. qui sum `var' if e(sample) == 1
 30. if "`outcome'" == "ihsloc" {
 31. qui sum afl_comb_`union'_locals if e(sample) == 1
 32. } 
 33. local depvarmean = string(r(mean),"%6.3fc")
 34. qui sum sh_euro_wa_10yr_m if e(sample) == 1
 35. local sheuromean = string(r(mean),"%6.3fc")
 36. local sheurostdev = string(r(sd),"%6.3fc")
 37. outreg2 using "$tables/`filename'_2sls", noobs append dec(3) label nor2 nocons stats(coef se) paren(se) ///
>                                                                         addtext("Nr. observations ", "`obs'", Dep. v
> ar. mean, "`depvarmean'", ///
>                                                                         Indep. var. mean, "`sheuromean'", ///
>                                                                         KP F-stat, "`fstat'", Estimator, 2SLS, /// 
>                                                                         "${fetext}, ${controlstext`n'}") ///
>                                                                         excel nonotes keep(sh_euro* pr*_sh_euro*) 
 38.                                                                                                 
. }
